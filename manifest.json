{
    "name": "Screw Haaretz (Desktop & Android)",
    "short_name": "ScrewHaaretz",
    "version": "0.1.4",
    "content_scripts": [{
            "matches": ["https://www.haaretz.co.il/*",
                "https://www.haaretz.com/*",
                "https://www.themarker.com/*"
            ],
            "js": ["content.js"]
        }
    ],
    "permissions": ["activeTab", "storage", "webRequest", "webRequestBlocking", "https://www.haaretz.co.il/*", "https://www.haaretz.com/*", "https://www.themarker.com/*"],
    "description": "Allows you to read full articles from haaretz.co.il/.com and themarker.com without any paywalls. Works also in incognito and Firefox for Android",
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "page_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/bonobo16.png",
            "32": "images/bonobo32.png",
            "48": "images/bonobo48.png",
            "128": "images/bonobo_icon.png"
        }
    },
    "icons": {
        "16": "images/bonobo16.png",
        "32": "images/bonobo32.png",
        "48": "images/bonobo48.png",
        "128": "images/bonobo_icon.png"
    },
    "manifest_version": 2
}